DATA_DIR=./.data
G_CLIENT_ID=
G_CLIENT_SECRET=
JWT_SECRET=
INIT_TABLE=true
ENABLE_CACHE=true
PRODUCTHUNT_API_TOKEN=

# Optional shared LLM runtime defaults.
# Every feature can inherit these, or override them with <FEATURE>_LLM_* keys.
# LLM_PROVIDER=minimax
# LLM_MODEL=MiniMax-M2.7
# LLM_API_KEY=
# LLM_BASE_URL=https://api.minimaxi.com/v1
# EVENT_ENGINE_SUBJECT_ROLE_TIMEOUT_MS=25000
#
# MiniMax can also be wired through the shared runtime.
# International endpoint: https://api.minimax.io/v1
# China mainland endpoint: https://api.minimaxi.com/v1
# LLM_PROVIDER=minimax
# MINIMAX_MODEL=MiniMax-M2.7
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Optional subject-role specific LLM override.
# EVENT_ENGINE_SUBJECT_ROLE_LLM_PROVIDER=openai
# EVENT_ENGINE_SUBJECT_ROLE_LLM_MODEL=gpt-5.4-mini
# EVENT_ENGINE_SUBJECT_ROLE_LLM_API_KEY=
# EVENT_ENGINE_SUBJECT_ROLE_LLM_BASE_URL=https://api.openai.com/v1
#
# Subject-role MiniMax override:
# EVENT_ENGINE_SUBJECT_ROLE_LLM_PROVIDER=minimax
# EVENT_ENGINE_SUBJECT_ROLE_LLM_MODEL=MiniMax-M2.7
# EVENT_ENGINE_SUBJECT_ROLE_LLM_API_KEY=
# EVENT_ENGINE_SUBJECT_ROLE_LLM_BASE_URL=https://api.minimaxi.com/v1

# Legacy OpenAI aliases are still accepted for backward compatibility:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
